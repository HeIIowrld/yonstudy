[Unit]
Description=Send the prepared LearnUs daily report
Documentation=file:/root/yonstudy/README.md
Wants=network-online.target
After=network-online.target yonstudy-daily.service

[Service]
Type=oneshot
WorkingDirectory=/root/yonstudy
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=-/etc/yonstudy/yonstudy.env
ExecStart=/usr/bin/flock -E 0 /run/yonstudy/automation.lock /usr/bin/python3 /root/yonstudy/cli.py report --sync-if-stale --email-if-configured
UMask=0077
RuntimeDirectory=yonstudy
RuntimeDirectoryMode=0700
TimeoutStartSec=1h
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/root/yonstudy/store

[Install]
WantedBy=multi-user.target
