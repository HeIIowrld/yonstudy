# 설치 위치에 맞게 바꾼 뒤, 서비스 실행 계정만 읽을 수 있게 권한을 600으로 둔다.
YONSTUDY_STORE=/root/yonstudy/store
LEARNUS_COOKIES=/root/yonstudy/store/learnus-cookies.txt
YONSTUDY_REMOTE=nas:home/yonstudy

# 자동화 한 번에 원격 보관할 VOD 수. 0은 현재 학기 전체이며 기본값이다.
YONSTUDY_VIDEO_ARCHIVE_LIMIT=0

# 자막이 없는 영상과 녹음을 재귀 검색해 같은 폴더에 `<원본>.ko.srt`를 만든다.
# NAS 공유는 먼저 /mnt 아래 등에 마운트한다. 값을 설정한 뒤 transcribe.timer를 켠다.
# YONSTUDY_TRANSCRIBE_ROOT=/mnt/hyunjin/homes/USER/02_Personal/01_학교/10.학기/2026-2
# YONSTUDY_TRANSCRIBE_MODEL=medium
# YONSTUDY_TRANSCRIBE_DEVICE=cpu
# YONSTUDY_TRANSCRIBE_COMPUTE_TYPE=int8
# YONSTUDY_TRANSCRIBE_LANGUAGE=auto
# YONSTUDY_TRANSCRIBE_STABLE_SECONDS=120
# YONSTUDY_TRANSCRIBE_CPU_THREADS=0
# YONSTUDY_TRANSCRIBE_MODEL_CACHE=/var/cache/yonstudy/whisper

# Playwright 번들 Chromium 대신 설치된 Chrome을 쓸 때 설정한다.
# YONSTUDY_BROWSER_CHANNEL=chrome

# 세션이 만료됐을 때 백그라운드에서 다시 로그인해야 하는 경우에만 사용한다.
# LEARNUS_ID=
# LEARNUS_PW=
# YONSEI_OJ_ID=
# YONSEI_OJ_PW=
# 새 주간 콘테스트 참여 상태를 자동으로 만들 때만 1로 설정한다.
# YONSTUDY_OJ_AUTO_JOIN=0

# 메일 리포트가 필요할 때 설정한다.
# YONSTUDY_REPORT_TO=
# YONSTUDY_MAIL_FROM=
# YONSTUDY_SMTP_HOST=
# YONSTUDY_SMTP_PORT=587
# YONSTUDY_SMTP_USER=
# YONSTUDY_SMTP_PASSWORD=
