# 설치 위치에 맞게 바꾼 뒤, 서비스 실행 계정만 읽을 수 있게 권한을 600으로 둔다.
YONSTUDY_STORE=/opt/yonstudy/store
LEARNUS_COOKIES=/opt/yonstudy/store/learnus-cookies.txt
YONSTUDY_REMOTE=nas:home/yonstudy

# 세션이 만료됐을 때 백그라운드에서 다시 로그인해야 하는 경우에만 사용한다.
# LEARNUS_ID=
# LEARNUS_PW=

# 메일 리포트가 필요할 때 설정한다.
# YONSTUDY_REPORT_TO=
# YONSTUDY_MAIL_FROM=
# YONSTUDY_SMTP_HOST=
# YONSTUDY_SMTP_PORT=587
# YONSTUDY_SMTP_USER=
# YONSTUDY_SMTP_PASSWORD=
