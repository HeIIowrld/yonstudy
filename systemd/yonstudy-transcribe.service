[Unit]
Description=Create missing lecture subtitles with local Whisper
Documentation=file:/root/yonstudy/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/yonstudy
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=-/etc/yonstudy/yonstudy.env
ExecStart=/usr/bin/flock -E 0 -n /run/yonstudy/transcription.lock /root/yonstudy/.venv/bin/python /root/yonstudy/cli.py transcribe --limit 1
RuntimeDirectory=yonstudy
RuntimeDirectoryMode=0700
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=12h
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
