FROM python:3.12-slim-bookworm

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TZ=Asia/Seoul \
    YONSTUDY_TRANSCRIBE_MODEL_CACHE=/models

RUN python -m pip install --no-cache-dir "faster-whisper==1.2.1"

WORKDIR /app

COPY cli.py ./
COPY yonstudy ./yonstudy
COPY deploy/transcribe_loop.py ./deploy/transcribe_loop.py

ENTRYPOINT ["/usr/local/bin/python", "/app/deploy/transcribe_loop.py"]
