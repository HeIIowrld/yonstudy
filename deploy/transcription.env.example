# Select exactly one Compose profile: local or remote.
COMPOSE_PROFILES=local

# Shared paths and optional overrides. Each profile has safe defaults:
# local=small/int8/2 threads/2 GB, remote=large-v3-turbo/int8/12 threads/7 GB.
YONSTUDY_TRANSCRIBE_BUILD_CONTEXT=.
YONSTUDY_TRANSCRIBE_MODEL_DIR=./.transcription/models
# YONSTUDY_TRANSCRIBE_MODEL=medium
# YONSTUDY_TRANSCRIBE_MODEL_ID=medium-int8
# YONSTUDY_TRANSCRIBE_CPU_THREADS=4
# YONSTUDY_TRANSCRIBE_CPUSET=0-3
# YONSTUDY_TRANSCRIBE_MEMORY=4g

# local profile: archive is mounted directly and results are written beside media.
YONSTUDY_TRANSCRIBE_ARCHIVE_DIR=/path/to/archive/2026-2
YONSTUDY_TRANSCRIBE_LOCAL_STATE_DIR=./.transcription/local/state

# remote profile: uncomment these values and set COMPOSE_PROFILES=remote.
# YONSTUDY_TRANSCRIBE_WORK_DIR=./.transcription/remote/archive
# YONSTUDY_TRANSCRIBE_REMOTE_STATE_DIR=./.transcription/remote/state
# YONSTUDY_RCLONE_CONFIG=/home/USER/.config/rclone/rclone.conf
# YONSTUDY_TRANSCRIBE_REMOTE=nas:path/to/semester
# YONSTUDY_TRANSCRIBE_REMOTE_STATE=nas:path/to/.yonstudy/transcription
