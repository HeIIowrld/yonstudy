# This file contains secrets in production. Keep it outside Git and mode 0600.
YONSTUDY_STORE=/data/store
LEARNUS_COOKIES=/data/store/learnus-cookies.txt
YONSTUDY_REMOTE=archive:
YONSTUDY_EXPORT_DIR=/data/exports
RCLONE_CONFIG=/config/rclone.conf
YONSTUDY_RECORDING_INBOX=/data/inbox/recordings
YONSTUDY_RECORDING_DESTINATION=/archive
YONSTUDY_RECORDING_STABLE_SECONDS=120
YONSTUDY_BROWSER_CHANNEL=chrome
# Docker cron의 강의 재생 시작을 각 예약 시각에서 최대 45분까지 분산한다.
YONSTUDY_WATCH_JITTER_SECONDS=2700
# 현재 학기에서 접근 가능한 모든 VOD를 매일 증분 보관한다. 양수면 실행당 편수 제한.
YONSTUDY_VIDEO_ARCHIVE_LIMIT=0
# LearnUs 전체 강좌 목록에 표시되지 않는 특수/비교과 강좌 ID. 쉼표로 여러 개 지정.
# YONSTUDY_EXTRA_COURSE_IDS=303762

# 시간표를 만들었을 때 활성화한다. 형식은 deploy/timetable.toml.example 참고.
# YONSTUDY_TIMETABLE=/config/timetable.toml

# LEARNUS_ID=
# LEARNUS_PW=
# YONSEI_OJ_ID=
# YONSEI_OJ_PW=
# YONSTUDY_OJ_AUTO_JOIN=0

# 과제·강좌 전사본 요약(Gemini). 과제는 수집 뒤, 강좌는 전사본 확인 뒤 증분 요약한다.
# 실제 키는 NAS의 /config/yonstudy.env 또는 0600 store/gemini-api-key에만 둔다.
# GEMINI_API_KEY=
# YONSTUDY_SUMMARY_MODEL=gemini-3.5-flash-lite
# YONSTUDY_SUMMARY_LIMIT=10

# YONSTUDY_REPORT_TO=
# YONSTUDY_MAIL_FROM=
# YONSTUDY_SMTP_HOST=
# YONSTUDY_SMTP_PORT=587
# YONSTUDY_SMTP_STARTTLS=1
# YONSTUDY_SMTP_USER=
# YONSTUDY_SMTP_PASSWORD=

# 과제별 ‘알림 제외’ 링크를 메일에 추가하고 받은 설정 메일을 3분마다 확인한다.
# Gmail은 기존 SMTP 계정과 앱 비밀번호를 사용한다. 다른 서비스는 IMAP도 지정한다.
# YONSTUDY_MAIL_ACTIONS=1
# YONSTUDY_IMAP_HOST=imap.gmail.com
# YONSTUDY_IMAP_PORT=993
# YONSTUDY_IMAP_USER=
# YONSTUDY_IMAP_PASSWORD=
# YONSTUDY_IMAP_MAILBOX=INBOX
