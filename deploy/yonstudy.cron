SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin
TZ=Asia/Seoul
PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
YONSTUDY_BROWSER_CHANNEL=chrome

# A second scan at least two minutes later confirms that an SMB upload is complete.
2-59/3 * * * * root /app/deploy/run-job.sh recordings

# Keep the LearnUs session alive every two hours.
25 */2 * * * root /app/deploy/run-job.sh keepalive

# Refresh VOD metadata, then process at most one due lecture per window.
0 2 * * * root /app/deploy/run-job.sh monitor
30 2 * * * root /app/deploy/run-job.sh watch
0 4 * * * root /app/deploy/run-job.sh watch
30 5 * * * root /app/deploy/run-job.sh watch

# Archive materials every six hours. The 06:10 run prepares the 09:00 report.
10 */6 * * * root /app/deploy/run-job.sh daily
0 9 * * * root /app/deploy/run-job.sh report
