# Host paths used by compose.yaml. This file is safe to keep beside compose.yaml.
YONSTUDY_DATA_DIR=/volume3/homes/USER/.yonstudy
YONSTUDY_CONFIG_DIR=/volume3/homes/USER/.yonstudy/config
YONSTUDY_ARCHIVE_DIR=/volume3/homes/USER/02_Personal/01_학교/10.학기
YONSTUDY_RECORDING_HOST_DIR=/volume3/homes/USER/02_Personal/01_학교/00.녹음_넣기
YONSTUDY_SOURCE_DIR=/volume3/homes/USER/.yonstudy/source
YONSTUDY_BUILD_CONTEXT=/volume3/homes/USER/.yonstudy/source

# 배포할 때 이 학기 폴더의 강의_자막_생성.py도 원자적으로 갱신한다.
# 생략하면 한국 시간 기준 현재 학기(/archive/YYYY-S)를 자동으로 찾는다.
YONSTUDY_DESKTOP_SCRIPT_DIR=/archive/2026-2

# `docker compose --profile transcription up -d transcriber`로 켤 때의 컨테이너 내부 경로.
# 전체 아카이브는 /archive이며 한 학기만 처리하려면 /archive/2026-2처럼 좁힌다.
YONSTUDY_TRANSCRIBE_ROOT=/archive/2026-2
YONSTUDY_TRANSCRIBE_MODEL=medium
YONSTUDY_TRANSCRIBE_DEVICE=cpu
YONSTUDY_TRANSCRIBE_COMPUTE_TYPE=int8
YONSTUDY_TRANSCRIBE_LANGUAGE=auto
YONSTUDY_TRANSCRIBE_STABLE_SECONDS=120
YONSTUDY_TRANSCRIBE_INTERVAL=1800
YONSTUDY_TRANSCRIBE_LIMIT=1
